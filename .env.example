# Application
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Twitch (create these in the Twitch Developer Console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/auth/twitch/callback
TWITCH_SCOPES=user:read:chat

# Qwen / OpenAI-compatible gateway
QWEN_API_KEY=
SOCLAAS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOCLAAS_MODEL=qwen-plus
LLM_ANALYSIS_INTERVAL_SECONDS=30
LLM_ANALYSIS_WINDOW_MESSAGES=100
LLM_REQUEST_TIMEOUT_SECONDS=90

# Frontend
VITE_API_BASE_URL=http://localhost:8000

